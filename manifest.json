{
  "manifest_version": 3,
  "name": "Gas Prices Quote Sidebar",
  "version": "0.2.0",
  "description": "Reads a shipping email as text, looks up the lane rate, and adds the weekly fuel surcharge and accessorials.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["sidePanel", "storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.live.com/*",
    "https://www.eia.gov/*",
    "https://geocoding.geo.census.gov/*",
    "https://nominatim.openstreetmap.org/*",
    "https://router.project-osrm.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "Open the quote sidebar"
    }
  },
  "action": {
    "default_title": "Open the quote sidebar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
